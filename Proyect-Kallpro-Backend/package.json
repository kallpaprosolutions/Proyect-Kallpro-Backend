{
  "name": "kallpapro-backend",
  "version": "0.1.0",
  "description": "Backend de KallpaPro - Plataforma B2B SaaS para PYMEs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seeds/index.ts",
    "db:init-sequences": "ts-node prisma/seeds/init-sequences.ts",
    "db:capture-invoice-links": "ts-node prisma/scripts/capture-invoice-links.ts",
    "db:restore-invoice-links": "ts-node prisma/scripts/restore-invoice-links.ts",
    "test:sequence": "ts-node prisma/tests/sequence-concurrency.ts",
    "db:reset": "prisma migrate reset"
  },
  "keywords": [
    "saas",
    "b2b",
    "inventory",
    "purchases",
    "logistics",
    "financials",
    "sales"
  ],
  "author": "KallpaPro Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^2.0.106",
    "@anthropic-ai/sdk": "^0.93.0",
    "@casl/ability": "^7.0.0",
    "@casl/prisma": "^2.0.1",
    "@prisma/client": "^5.8.0",
    "@types/pdfkit": "^0.17.6",
    "ai": "^5.0.196",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.5",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ec-sri-invoice-signer": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.2",
    "node-forge": "^1.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/node-forge": "^1.3.14",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
