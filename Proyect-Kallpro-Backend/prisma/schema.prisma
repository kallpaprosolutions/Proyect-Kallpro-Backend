model CrmAgentRun {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentId          String
  agent            CrmAgent @relation(fields: [agentId], references: [id])
  agentCode        String
  conversationId   String?
  dealId           String?
  inputContext     Json
  output           Json?
  toolsCalled      String[] @default([])
  tokensInput      Int      @default(0)
  tokensOutput     Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs        Int      @default(0)
  status           String   @default("success") // success | failed | escalated | timeout
  errorMessage     String?
  requiresApproval Boolean  @default(false)
  approvedBy       String?
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([agentCode])
  @@index([conversationId])
  @@index([createdAt])
  @@map("crm_agent_runs")
}

model CrmWorkflow {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  trigger    String // new_contact | stage_change | no_activity | time_based
  conditions Json     @default("{}")
  actions    Json     @default("[]")
  isActive   Boolean  @default(true)
  runCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?

  @@index([companyId])
  @@index([trigger])
  @@map("crm_workflows")
}

model CrmLeadScore {
  id             String     @id @default(uuid())
  contactId      String
  contact        CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  budgetScore    Int        @default(0) // 0-25
  authorityScore Int        @default(0) // 0-25
  needScore      Int        @default(0) // 0-25
  timelineScore  Int        @default(0) // 0-25
  totalScore     Int        @default(0) // 0-100
  evidence       String? // cita textual de la conversación
  scoredBy       String     @default("system") // agent code | human
  scoredAt       DateTime   @default(now())

  @@index([contactId])
  @@index([scoredAt])
  @@map("crm_lead_scores")
}

model CrmForecast {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           String // "2026-05"
  totalPipelineUsd Decimal  @default(0) @db.Decimal(14, 2)
  weightedFcstUsd  Decimal  @default(0) @db.Decimal(14, 2)
  wonUsd           Decimal  @default(0) @db.Decimal(14, 2)
  byStage          Json     @default("{}") // { lead: {count, amount}, qualified: {...} }
  calculatedAt     DateTime @default(now())

  // ─── Categorías de pronóstico (Sprint 13) ────────────────────────
  // Se guardan como foto del período para poder medir la PRECISIÓN después: al cerrar
  // el mes se compara commitUsd contra lo realmente ganado. Sin la foto no hay forma
  // de saber si el vendedor sub- o sobre-pronosticó.
  commitUsd        Decimal @default(0) @db.Decimal(14, 2)
  bestCaseUsd      Decimal @default(0) @db.Decimal(14, 2)
  omittedUsd       Decimal @default(0) @db.Decimal(14, 2)
  quotaUsd         Decimal @default(0) @db.Decimal(14, 2) // cuota del período (0 = sin cuota)
  coverageRatio    Float   @default(0) // pipeline abierto ÷ cuota
  byCategory       Json    @default("{}")
  // Precisión medida al cerrar el período: won ÷ commit y won ÷ bestCase (en %).
  commitAccuracy   Float?
  bestCaseAccuracy Float?
  isClosed         Boolean @default(false)

  @@unique([companyId, period])
  @@index([companyId])
  @@map("crm_forecasts")
}

model CrmTemplate {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  channel    String // whatsapp | telegram | gmail
  category   String   @default("utility") // utility | marketing | transactional
  subject    String? // para email
  body       String   @db.Text
  variables  Json     @default("[]") // [{ name, description, example }]
  isApproved Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?

  @@index([companyId])
  @@index([channel])
  @@map("crm_templates")
}

// ============================================================
// CRM PRO (Sprint 13) — captura de leads, scoring configurable y pronóstico
// ============================================================
// Decisión de diseño: el LEAD es una entidad SEPARADA del contacto. Un lead es materia
// prima sin verificar (puede ser spam, duplicado o basura); un CrmContact es un registro
// del que ya nos hacemos responsables. Mezclarlos —como hace un CRM ingenuo— ensucia la
// base con miles de registros basura y rompe cualquier métrica de conversión.
// El lead se CONVIERTE (una sola vez) en contacto + empresa + oportunidad.

model CrmLead {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ─── Datos crudos tal como llegaron ──────────────────────────────
  firstName   String?
  lastName    String?
  email       String?
  phone       String? // se normaliza a E.164 al entrar
  jobTitle    String?
  companyName String?
  ruc         String?
  website     String?
  city        String?
  message     String? @db.Text
  // Respuestas de campos personalizados del formulario, sin mapear.
  rawPayload  Json?   @default("{}")

  // ─── Atribución (los 8-12 campos ocultos del formulario) ─────────
  source      String          @default("manual") // web_form | whatsapp | telegram | gmail | import | manual | api
  formId      String?
  form        CrmCaptureForm? @relation(fields: [formId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  landingPage String?
  gclid       String?
  ipAddress   String?
  userAgent   String?

  // ─── Estado y calificación ───────────────────────────────────────
  status         String    @default("NEW") // NEW | WORKING | QUALIFIED | CONVERTED | DISQUALIFIED
  // Score total 0-100 calculado por el motor de reglas (fit + engagement - negativos).
  score          Int       @default(0)
  fitScore       Int       @default(0)
  engageScore    Int       @default(0)
  grade          String    @default("D") // A | B | C | D
  temperature    String    @default("cold") // hot | warm | cold
  // Traza de por qué el lead tiene ese score: [{ ruleId, ruleName, category, points }].
  // Sin esto el score es una caja negra y el vendedor no confía en él.
  scoreBreakdown Json      @default("[]")
  scoredAt       DateTime?

  // ─── Deduplicación ───────────────────────────────────────────────
  // Se calcula al entrar; no se borra el duplicado, se marca para que un humano decida.
  isDuplicate   Boolean @default(false)
  duplicateOfId String?
  dedupeScore   Int     @default(0) // 0-100, confianza de la coincidencia
  dedupeReason  String?

  // ─── Asignación y conversión ─────────────────────────────────────
  ownerUserId        String?
  assignedByRuleId   String?
  disqualifyReason   String?
  convertedAt        DateTime?
  convertedContactId String?
  convertedCompanyId String?
  convertedDealId    String?

  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CrmLeadEvent[]

  @@index([companyId])
  @@index([status])
  @@index([score])
  @@index([email])
  @@index([phone])
  @@index([ownerUserId])
  @@index([source])
  @@index([createdAt])
  @@map("crm_leads")
}

// Cada señal de interés del lead. El motor de scoring cuenta eventos y les aplica
// DECAIMIENTO por media vida: un formulario enviado hace 6 meses no vale lo mismo que
// uno de ayer. Sin eventos con fecha no hay forma de decaer nada.
model CrmLeadEvent {
  id     String  @id @default(uuid())
  leadId String
  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  eventType  String // form_submit | email_open | email_click | page_view | pricing_view | demo_request | message_reply | meeting_booked | doc_download | unsubscribe
  channel    String? // web | whatsapp | telegram | gmail
  metadata   Json?    @default("{}")
  occurredAt DateTime @default(now())

  @@index([leadId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("crm_lead_events")
}

// Formulario público editable desde la interfaz. Los campos viven en JSON porque el
// usuario los define en runtime; el backend valida contra esa definición al recibir.
model CrmCaptureForm {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  // Clave pública que va en el <script> o el iframe del sitio del cliente. Es lo único
  // que el navegador conoce: NO expone el companyId ni requiere token.
  publicKey   String  @unique
  description String?

  // [{ key, label, type, required, placeholder, options?, mapsTo }]
  // mapsTo: campo de CrmLead al que se copia; si no hay, va a rawPayload.
  fields         Json    @default("[]")
  consentText    String? @db.Text // texto de tratamiento de datos (Ley Orgánica de Protección de Datos EC)
  requireConsent Boolean @default(true)
  successMessage String  @default("¡Gracias! Nos pondremos en contacto contigo.")
  redirectUrl    String?

  // Comportamiento al recibir
  defaultOwnerUserId String?
  autoScore          Boolean  @default(true)
  autoAssign         Boolean  @default(true)
  tags               String[] @default([])

  isActive        Boolean  @default(true)
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  leads CrmLead[]

  @@index([companyId])
  @@index([publicKey])
  @@map("crm_capture_forms")
}

// Regla de scoring editable. Se evalúa contra el lead (campos + eventos) y suma o resta
// puntos. FIT = quién es (firmográfico); ENGAGEMENT = qué hizo (conductual, decae);
// NEGATIVE = motivo de descalificación (resta siempre, no decae).
model CrmScoringRule {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  category     String // FIT | ENGAGEMENT | NEGATIVE
  // Campo del lead (email, jobTitle, companyName, city, ruc, utmSource…) o, cuando
  // operator = EVENT_COUNT, el eventType a contar.
  field        String
  operator     String // EQUALS | NOT_EQUALS | CONTAINS | NOT_CONTAINS | IN | GT | GTE | LT | LTE | BETWEEN | EXISTS | NOT_EXISTS | EVENT_COUNT
  // Valor de comparación. Siempre string[] para poder representar IN y BETWEEN sin
  // multiplicar columnas; el motor castea según el operador.
  value        String[] @default([])
  points       Int      @default(0) // negativo en reglas NEGATIVE
  // Tope de puntos si la regla puede dispararse varias veces (EVENT_COUNT).
  maxPoints    Int?
  // Días de media vida propios de esta regla; si es null usa el global de la config.
  halfLifeDays Int?

  description String?
  isActive    Boolean  @default(true)
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([category])
  @@map("crm_scoring_rules")
}

// Una fila por empresa: pesos, umbrales y cortes de grado. Editable desde la interfaz.
model CrmScoringConfig {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Pesos con los que se combinan fit y engagement (deben sumar 100).
  fitWeight        Int @default(50)
  engagementWeight Int @default(50)

  // Media vida global del engagement, en días. A los `halfLifeDays` un evento vale la
  // mitad; a los 2×, un cuarto. 30 días es el estándar de la industria.
  halfLifeDays Int @default(30)

  // Umbrales de ciclo de vida.
  mqlThreshold Int @default(50)
  sqlThreshold Int @default(75)

  // Cortes de grado (score >= corte). A > B > C, el resto es D.
  gradeAThreshold Int @default(80)
  gradeBThreshold Int @default(60)
  gradeCThreshold Int @default(40)

  // Cortes de temperatura para el semáforo de la bandeja.
  hotThreshold  Int @default(75)
  warmThreshold Int @default(45)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("crm_scoring_config")
}

// Etapas del pipeline por empresa. Sustituye la constante STAGE_PROBABILITY quemada en
// deal.service.ts: la probabilidad y la categoría de pronóstico ahora las define el
// usuario, que es quien conoce su tasa real de conversión.
model CrmPipelineStage {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code             String // lead | qualified | proposal | negotiation | won | lost | personalizada
  name             String // etiqueta en español que ve el usuario
  sequence         Int     @default(0)
  probability      Int     @default(10) // 0-100
  forecastCategory String  @default("PIPELINE") // PIPELINE | BEST_CASE | COMMIT | CLOSED | OMITTED
  isWon            Boolean @default(false)
  isLost           Boolean @default(false)
  // Compuerta de verificación: qué debe cumplirse para promover a esta etapa. Es la
  // palanca de precisión más grande del pronóstico (criterios documentados de Commit).
  entryCriteria    String? @db.Text
  // Días esperados en la etapa; por encima, la oportunidad se marca estancada.
  targetDays       Int     @default(14)
  color            String  @default("#6b7280")
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("crm_pipeline_stages")
}

// Regla de enrutamiento: condiciones sobre el lead → propietario (fijo o round-robin).
// Se evalúan por prioridad ascendente y gana la primera que casa (como un firewall).
model CrmAssignmentRule {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  priority   Int    @default(100)
  // [{ field, operator, value: string[] }] — mismos operadores que el scoring.
  conditions Json   @default("[]")

  assignMode  String   @default("ROUND_ROBIN") // FIXED | ROUND_ROBIN
  ownerUserId String? // usado si assignMode = FIXED
  poolUserIds String[] @default([]) // usado si assignMode = ROUND_ROBIN
  // Cursor del round-robin: índice del último usuario asignado de la lista.
  rrCursor    Int      @default(0)

  isActive   Boolean  @default(true)
  matchCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([priority])
  @@map("crm_assignment_rules")
}

// ============================================================
// LOGÍSTICA — envíos con tracking estilo courier (ventas y compras)
// ============================================================

model Shipment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Orden vinculada (bidireccional): pedido de venta o entrada de OC
  orderType String // SALES | PURCHASE
  orderId   String

  trackingNumber String // KP-XXXXXXXX (interno) — único POR EMPRESA (ver @@unique abajo), no global
  carrier        String? // SERVIENTREGA | TRAMACO | DHL | PROPIO | otro
  carrierGuide   String? // nº de guía del courier externo (si aplica)

  status String @default("PENDING") // PENDING | PICKED | DISPATCHED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | FAILED

  // Costo real del flete (courier o transporte propio) — insumo para que Ventas conozca el
  // margen real de la entrega, no solo el del producto.
  freightCost Decimal @default(0) @db.Decimal(12, 2)

  originAddress     String?
  destAddress       String?
  recipientName     String?
  recipientPhone    String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  events         ShipmentEvent[]
  items          ShipmentItem[]
  deliveryGuides DeliveryGuide[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, trackingNumber]) // numeración por empresa (evita colisión multi-tenant)
  @@index([companyId])
  @@index([orderType, orderId])
  @@index([status])
  @@map("shipments")
}

// Líneas de un envío de venta: qué cantidad de cada ítem del pedido va en este envío.
// Permite despachos PARCIALES y facturación por envío (1 pedido → N envíos → N facturas).
model ShipmentItem {
  id               String         @id @default(uuid())
  shipmentId       String
  shipment         Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productId        String
  quantity         Decimal        @db.Decimal(12, 4)
  // Costo unitario REAL capturado al despachar (capas FIFO/LIFO consumidas o avgCost).
  // La factura del envío usa este valor para el asiento de COGS exacto; 0 = legado
  // (envíos anteriores al fix), en cuyo caso se cae a product.avgCost.
  unitCost         Decimal        @default(0) @db.Decimal(12, 4)

  @@index([shipmentId])
  @@index([salesOrderItemId])
  @@map("shipment_items")
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status    String // mismo catálogo que Shipment.status
  eventTime DateTime @default(now())
  location  String?
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([eventTime])
  @@map("shipment_events")
}

// ============================================================
// NUMERACIÓN ATÓMICA DE DOCUMENTOS
// ============================================================
// Un contador por (companyId, docType). El incremento se hace dentro de la misma
// transacción con `update { lastNumber: { increment: 1 } }`, evitando colisiones de
// correlativos bajo concurrencia. Helper: src/utils/sequence.helper.ts
model DocumentSequence {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType    String // SALES_QUOTATION | SALES_ORDER | SALES_INVOICE | PAYMENT | SHIPMENT | ...
  prefix     String // COT- | PV- | FAC-V- | PAG- | KP- ...
  lastNumber Int      @default(0)
  padding    Int      @default(4)
  updatedAt  DateTime @updatedAt

  @@unique([companyId, docType])
  @@index([companyId])
  @@map("document_sequences")
}

// ============================================================
// FACTURACIÓN ELECTRÓNICA SRI — BASE NORMATIVA (Etapa 1)
// ============================================================
// Config normativa por empresa: ambiente (pruebas/producción), establecimientos y puntos de
// emisión (numeración exigida por el SRI, independiente de la numeración interna FAC-V-####
// que el ERP ya usa para búsqueda humana). El secuencial de 9 dígitos por comprobante SRI
// reusa `DocumentSequence`/`getNextDocumentNumber` con docType compuesto
// (p.ej. "SRI_FACTURA_001_001"), padding 9, prefix "" — evita una tabla de contador duplicada.
model CompanyFiscalConfig {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruc                   String
  razonSocial           String
  nombreComercial       String?
  // PRUEBAS apunta a celcer.sri.gob.ec (ambiente de certificación), PRODUCCION a cel.sri.gob.ec.
  // Cambiarlo desde el frontend exige confirmación explícita: afecta documentos reales.
  ambiente              String   @default("PRUEBAS")
  tipoEmision           String   @default("NORMAL") // NORMAL | CONTINGENCIA
  obligadoContabilidad  Boolean  @default(true)
  contribuyenteEspecial String? // número de resolución; null si no aplica
  regimen               String   @default("GENERAL") // GENERAL | RIMPE_EMPRENDEDOR | RIMPE_NEGOCIO_POPULAR
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  establishments Establishment[]
  certificates   DigitalCertificate[]

  @@map("company_fiscal_config")
}

model Establishment {
  id             String              @id @default(uuid())
  fiscalConfigId String
  fiscalConfig   CompanyFiscalConfig @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)
  code           String // 3 dígitos exigidos por el SRI: "001"
  name           String // "Matriz", "Sucursal Norte"...
  address        String
  isMatriz       Boolean             @default(false)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())

  emissionPoints EmissionPoint[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  debitNotes     DebitNote[]
  deliveryGuides DeliveryGuide[]

  @@unique([fiscalConfigId, code])
  @@map("fiscal_establishments")
}

model EmissionPoint {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  code            String // 3 dígitos exigidos por el SRI: "001"
  name            String? // "Caja 1", "Ventas web"... (uso interno, no lo exige el SRI)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  invoices       Invoice[]
  creditNotes    CreditNote[]
  debitNotes     DebitNote[]
  deliveryGuides DeliveryGuide[]

  @@unique([establishmentId, code])
  @@map("fiscal_emission_points")
}

// Certificado de firma electrónica (.p12) por empresa. El archivo y la contraseña se cifran
// en reposo (AES-256-GCM, clave de aplicación en CERT_ENCRYPTION_KEY — nunca la contraseña
// real del usuario); ningún endpoint GET devuelve `fileDataEnc` ni `passwordEnc`.
model DigitalCertificate {
  id             String              @id @default(uuid())
  fiscalConfigId String
  fiscalConfig   CompanyFiscalConfig @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)
  alias          String
  fileDataEnc    Bytes // .p12 cifrado (AES-256-GCM: iv(12) + tag(16) + ciphertext)
  passwordEnc    String // contraseña del .p12 cifrada (iv:tag:ciphertext en hex)
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())

  @@index([fiscalConfigId])
  @@map("fiscal_digital_certificates")
}

// ============================================================
// TESORERÍA — PAGOS Y APLICACIÓN DE PAGOS
// ============================================================
// Un Payment es un cobro (CUSTOMER) o pago (SUPPLIER). Puede aplicarse parcial o
// totalmente a una o varias facturas (Invoice) vía PaymentApplication. El remanente
// no aplicado queda como crédito a favor (totalAmount - appliedAmount).
model Payment {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentNumber String // PAG-0001 — único POR EMPRESA (ver @@unique abajo), no global
  entityType    String // CUSTOMER | SUPPLIER
  entityId      String // customerId o supplierId
  paymentMethod String // CASH | BANK_TRANSFER | CARD | CHECK | OTHER
  reference     String?
  totalAmount   Decimal  @db.Decimal(12, 2)
  appliedAmount Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("UNAPPLIED") // UNAPPLIED | PARTIAL | APPLIED
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications PaymentApplication[]

  @@unique([companyId, paymentNumber]) // numeración por empresa (evita colisión multi-tenant)
  @@index([companyId])
  @@index([entityType, entityId])
  @@map("payments")
}

model PaymentApplication {
  id            String       @id @default(uuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Se aplica exactamente a UNO de los dos (Invoice = AR/legacy AP manual, SriDocument = AP real).
  // La regla de "exactamente uno" se valida en payment.service.ts, no a nivel de DB.
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  sriDocumentId String?
  sriDocument   SriDocument? @relation(fields: [sriDocumentId], references: [id])
  amountApplied Decimal      @db.Decimal(12, 2)
  appliedAt     DateTime     @default(now())
  createdBy     String?

  @@index([paymentId])
  @@index([invoiceId])
  @@index([sriDocumentId])
  @@map("payment_applications")
}

// Programación de pagos (CxP) — Fase 3 del Asistente Contable Inteligente. Agenda un pago
// futuro con la prioridad calculada al momento de programar (vencimiento, importancia del
// proveedor, monto, impacto en flujo de caja — ver payment-priority.engine.ts); NO ejecuta
// el pago. Al procesarse (individual o en lote "Procesar todo") crea el Payment real vía
// ap.service.payPayable y esta fila pasa a PROCESSED enlazada a él.
model PaymentSchedule {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sriDocumentId      String
  sriDocument        SriDocument  @relation(fields: [sriDocumentId], references: [id])
  scheduledDate      DateTime
  amount             Decimal      @db.Decimal(12, 2)
  bankAccountId      String?
  bankAccount        BankAccount? @relation(fields: [bankAccountId], references: [id])
  priorityScore      Int // score 0-100 calculado al programar (payment-priority.engine)
  priorityLevel      String // ALTA | MEDIA | BAJA
  notes              String?
  status             String       @default("SCHEDULED") // SCHEDULED | PROCESSED | CANCELLED
  processedPaymentId String?
  processedAt        DateTime?
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([companyId, status])
  @@index([sriDocumentId])
  @@index([companyId, scheduledDate])
  @@map("payment_schedules")
}

// Gestión de cobranza (CxC): historial de contactos y compromisos de pago sobre la cartera
// vencida. No reemplaza el Payment (el cobro real); registra el trabajo de cobranza que
// lleva a ese cobro — lo que un asistente de cuentas por cobrar necesita para priorizar
// a quién llamar hoy y no perder el hilo de lo prometido.
model CollectionActivity {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  type           String // CALL | EMAIL | WHATSAPP | MEETING | PAYMENT_PROMISE | NOTE
  result         String? // resultado de la gestión (texto libre)
  promisedAmount Decimal?  @db.Decimal(12, 2)
  promisedDate   DateTime?
  nextActionAt   DateTime?
  notes          String?
  createdBy      String?
  // Recordatorios automáticos de cobranza (dunning): `automated` los distingue de la gestión
  // humana y `dunningStep` (índice del escalón de ErpConfig.finance.dunning.steps) garantiza
  // que cada escalón se dispare UNA sola vez por factura.
  automated      Boolean   @default(false)
  dunningStep    Int?
  createdAt      DateTime  @default(now())

  @@index([companyId, customerId])
  @@index([companyId, nextActionAt])
  @@index([companyId, invoiceId, automated])
  @@map("collection_activities")
}

// ═══════════════════════════════════════════════════════════════
// NÓMINA (RRHH) — Sprint 8. Normativa Ecuador 2026.
// ═══════════════════════════════════════════════════════════════

// Empleado en relación de dependencia. Puede (o no) estar vinculado a un User del sistema.
model Employee {
  id                        String      @id @default(uuid())
  companyId                 String
  company                   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                    String? // vínculo opcional con el usuario del ERP
  cedula                    String
  firstName                 String
  lastName                  String
  email                     String?
  phone                     String?
  departmentId              String?
  department                Department? @relation(fields: [departmentId], references: [id])
  position                  String // cargo descriptivo (ej. "Jefe de Bodega")
  category                  String // JEFATURA | ASISTENTE | SERVICIOS
  baseSalary                Decimal     @db.Decimal(12, 2)
  hireDate                  DateTime
  terminationDate           DateTime?
  // Beneficios: forma de pago elegida por el empleado (Acuerdo MDT)
  monthlyThirteenth         Boolean     @default(false) // décimo tercero mensualizado
  monthlyFourteenth         Boolean     @default(false) // décimo cuarto mensualizado
  reserveFundsToIESS        Boolean     @default(false) // fondos de reserva acumulados en IESS (si no, se pagan en el rol)
  // Datos para retención de impuesto a la renta
  familyBurdens             Int         @default(0) // cargas familiares (rebaja gastos personales)
  projectedPersonalExpenses Decimal     @default(0) @db.Decimal(12, 2) // gastos personales proyectados anuales
  bankAccount               String?
  isActive                  Boolean     @default(true)
  managerId                 String? // jefatura directa (auto-relación) — aprobación de permisos
  manager                   Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  payslips           Payslip[]
  novelties          PayrollNovelty[]
  attendance         AttendanceRecord[]
  directReports      Employee[]         @relation("EmployeeManager")
  shifts             ShiftAssignment[]
  leaveRequests      LeaveRequest[]     @relation("LeaveRequester")
  approvalsAsManager LeaveRequest[]     @relation("ManagerApprover")

  @@unique([companyId, cedula])
  @@index([companyId, isActive])
  @@index([managerId])
  @@map("employees")
}

// Plantilla reutilizable de turno (ej. "Turno mañana" 08:00-17:00).
model ShiftTemplate {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  breakMinutes Int      @default(60)
  color        String? // color para pintar la tarjeta en el calendario
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments ShiftAssignment[]

  @@unique([companyId, name])
  @@map("shift_templates")
}

// Turno planeado de un colaborador para un día específico (la "tarjeta" del calendario).
model ShiftAssignment {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  date            DateTime // día del turno (medianoche UTC)
  startTime       String // "HH:mm" (copiado de la plantilla o personalizado)
  endTime         String // "HH:mm"
  status          String         @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  notes           String?
  createdById     String // userId del analista TTHH que agendó/reprogramó
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("shift_assignments")
}

// Solicitud de permiso/vacaciones con doble aprobación: jefatura directa → TTHH.
model LeaveRequest {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  type              String // VACACIONES | ENFERMEDAD | PERSONAL | CALAMIDAD_DOMESTICA | PERMISO_NO_REMUNERADO | OTRO
  startDate         DateTime
  endDate           DateTime
  reason            String
  status            String    @default("PENDIENTE_JEFATURA") // PENDIENTE_JEFATURA | PENDIENTE_TTHH | APROBADO | RECHAZADO | CANCELADO
  managerId         String?
  manager           Employee? @relation("ManagerApprover", fields: [managerId], references: [id])
  managerDecisionAt DateTime?
  managerComment    String?
  hrDecisionById    String? // userId de TTHH que decide
  hrDecisionAt      DateTime?
  hrComment         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("leave_requests")
}

// Período mensual de nómina. Flujo: DRAFT → PROCESSED → POSTED → PAID
model PayrollPeriod {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  status         String    @default("DRAFT") // DRAFT | PROCESSED | POSTED | PAID
  journalEntryId String? // asiento de devengo (al contabilizar)
  paymentEntryId String? // asiento de pago (al pagar)
  processedAt    DateTime?
  postedAt       DateTime?
  paidAt         DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payslips  Payslip[]
  novelties PayrollNovelty[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("payroll_periods")
}

// Rol de pago individual (un empleado en un período).
model Payslip {
  id              String        @id @default(uuid())
  periodId        String
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  // Totales calculados
  grossEarnings   Decimal       @db.Decimal(12, 2) // ingresos gravados IESS (sueldo + horas + bonos)
  otherEarnings   Decimal       @db.Decimal(12, 2) // no gravados (décimos mensualizados, fondos de reserva)
  totalDeductions Decimal       @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  employerCost    Decimal       @db.Decimal(12, 2) // aporte patronal + provisiones
  createdAt       DateTime      @default(now())

  lines PayslipLine[]

  @@unique([periodId, employeeId])
  @@map("payslips")
}

// Línea del rol: ingreso, descuento o costo/provisión patronal.
model PayslipLine {
  id        String  @id @default(uuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind      String // EARNING | DEDUCTION | EMPLOYER (costo/provisión patronal, no afecta el neto)
  concept   String // código: SUELDO, HORAS_SUP, DECIMO_TERCERO, APORTE_IESS, IR, etc.
  label     String // texto legible
  amount    Decimal @db.Decimal(12, 2)
  meta      Json? // detalle (horas, tasa, base de cálculo)

  @@index([payslipId])
  @@map("payslip_lines")
}

// Novedades del período: horas extras, bonos, anticipos, préstamos, pensiones, multas.
model PayrollNovelty {
  id         String        @id @default(uuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  type       String // HORAS_SUPLEMENTARIAS | HORAS_EXTRAORDINARIAS | BONO | COMISION | ANTICIPO | PRESTAMO_QUIROGRAFARIO | PRESTAMO_HIPOTECARIO | PENSION_ALIMENTICIA | MULTA | OTRO_INGRESO | OTRO_DESCUENTO
  hours      Decimal?      @db.Decimal(8, 2) // para horas extras
  amount     Decimal?      @db.Decimal(12, 2) // para montos directos
  notes      String?
  createdBy  String?
  createdAt  DateTime      @default(now())

  @@index([periodId, employeeId])
  @@map("payroll_novelties")
}

// ═══════════════════════════════════════════════════════════════
// TESORERÍA (Sprint 9) — bancos, pagos, cobros, flujo de caja
// ═══════════════════════════════════════════════════════════════

// Cuenta bancaria de la empresa (nacional o extranjera).
model BankAccount {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankCode       String // código del catálogo bancosEcuador.ts, o 'EXTRANJERO'
  bankName       String
  accountNumber  String
  accountType    String   @default("CORRIENTE") // CORRIENTE | AHORROS
  currency       String   @default("USD")
  swiftCode      String? // BIC para transferencias internacionales
  iban           String? // cuentas en el exterior
  isForeign      Boolean  @default(false)
  alias          String? // nombre corto para la UI (ej. "Pichincha principal")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions     BankTransaction[]
  statementLines   BankStatementLine[]
  paymentSchedules PaymentSchedule[]

  @@unique([companyId, bankCode, accountNumber])
  @@index([companyId, isActive])
  @@map("bank_accounts")
}

// Movimiento bancario: pagos (egresos) y cobros/recepciones (ingresos).
// Cuando nace de una obligación del ERP (nómina, factura, impuesto) queda
// vinculado por sourceType/sourceId y al asiento contable generado.
model BankTransaction {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccountId  String
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id])
  type           String // INGRESO | EGRESO
  method         String // TRANSFERENCIA | CHEQUE | EFECTIVO | SWIFT | TARJETA
  amount         Decimal     @db.Decimal(14, 2)
  currency       String      @default("USD")
  exchangeRate   Decimal?    @db.Decimal(12, 6) // para moneda extranjera → USD
  date           DateTime    @default(now())
  reference      String? // n.º de cheque, comprobante, MT103…
  beneficiary    String? // beneficiario / pagador
  swiftCode      String? // BIC destino en pagos al exterior
  status         String      @default("REGISTRADO") // REGISTRADO | CONCILIADO | ANULADO
  sourceType     String? // PAYROLL | AP_INVOICE | AR_INVOICE | TAX_SRI | TAX_IESS | MANUAL
  sourceId       String?
  journalEntryId String?
  notes          String?
  createdBy      String?
  createdAt      DateTime    @default(now())

  @@index([companyId, date])
  @@index([bankAccountId])
  @@index([sourceType, sourceId])
  @@map("bank_transactions")
}

// Registro de asistencia (biométrico o manual) — alimenta horas extras de nómina.
model AttendanceRecord {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime // día laborado (medianoche UTC)
  checkIn     DateTime
  checkOut    DateTime
  hoursWorked Decimal  @db.Decimal(6, 2) // horas netas del día
  source      String   @default("BIOMETRIC") // BIOMETRIC | MANUAL
  deviceId    String? // identificador del reloj biométrico
  createdAt   DateTime @default(now())

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("attendance_records")
}

// Línea del extracto bancario importado (conciliación automática/semiautomática).
// El monto es con signo: positivo = crédito (ingreso), negativo = débito (egreso).
model BankStatementLine {
  id                   String      @id @default(uuid())
  companyId            String
  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccountId        String
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date                 DateTime
  description          String
  reference            String?
  amount               Decimal     @db.Decimal(14, 2)
  status               String      @default("PENDIENTE") // PENDIENTE | CONCILIADO | CREADO (movimiento creado desde el extracto)
  matchedTransactionId String? // bank_transactions.id conciliado
  matchType            String? // AUTO | MANUAL
  importedAt           DateTime    @default(now())
  importedBy           String?

  @@index([companyId, bankAccountId, status])
  @@map("bank_statement_lines")
}
