generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANTS & USERS
// ============================================================

model Company {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  industry  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  users          User[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  subscriptions  Subscription[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email     String   @unique
  passwordHash String
  firstName String?
  lastName  String?
  role      String   @default("USER") // ADMIN, MANAGER, USER, VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@index([companyId])
  @@index([email])
}

// ============================================================
// INVENTORY
// ============================================================

model Product {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku       String?  @unique
  name      String
  description String?
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal? @db.Decimal(12, 2)
  categoryId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  inventory InventoryEntry?

  @@map("products")
  @@index([companyId])
  @@index([sku])
}

model InventoryEntry {
  id        String   @id @default(uuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand Int @default(0)
  quantityReserved Int @default(0)
  reorderPoint Int?
  reorderQuantity Int?
  warehouseLocation String?
  lastUpdated DateTime @default(now()) @updatedAt

  @@map("inventory")
  @@index([productId])
}

model InventoryMovement {
  id        String   @id @default(uuid())
  companyId String
  productId String
  type      String   // IN, OUT, ADJUSTMENT, RETURN
  quantity  Int
  reference String?  // PO number, order number
  notes     String?
  createdAt DateTime @default(now())

  @@map("inventory_movements")
  @@index([companyId])
  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// PURCHASES
// ============================================================

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  paymentTerms String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
  @@index([companyId])
}

model PurchaseOrder {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId String
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  poNumber  String   @unique
  status    String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RECEIVED, CANCELLED
  totalAmount Decimal @db.Decimal(12, 2)
  deliveryDate DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items POItem[]

  @@map("purchase_orders")
  @@index([companyId])
  @@index([status])
}

model POItem {
  id        String   @id @default(uuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String?
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  receivedQuantity Int @default(0)

  @@map("po_items")
  @@index([poId])
}

// ============================================================
// SUBSCRIPTIONS & BILLING
// ============================================================

model SubscriptionPlan {
  id        String   @id @default(uuid())
  name      String   @unique // STARTER, PROFESSIONAL, ENTERPRISE
  priceMonthly Decimal @db.Decimal(10, 2)
  description String?
  features  String   // JSON stringified
  maxUsers  Int?
  maxProducts Int?
  isActive  Boolean  @default(true)

  // Relations
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String   @id @default(uuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  status    String   @default("TRIAL") // TRIAL, ACTIVE, PAUSED, CANCELLED
  billingEmail String?
  startDate DateTime @default(now())
  renewalDate DateTime?
  trialEndsAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  billingHistory BillingHistory[]

  @@map("subscriptions")
  @@index([companyId])
  @@index([status])
}

model BillingHistory {
  id        String   @id @default(uuid())
  companyId String
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  status    String   // PENDING, PAID, FAILED
  paymentProvider String? // UNO, KUSKI
  transactionId String?
  invoiceDate DateTime
  dueDate   DateTime?
  paidDate  DateTime?
  createdAt DateTime @default(now())

  @@map("billing_history")
  @@index([companyId])
  @@index([status])
}

// ============================================================
// FINANCIALS
// ============================================================

model Invoice {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String   @unique
  type      String   // SALES, PURCHASE
  status    String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE
  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount Decimal @db.Decimal(12, 2) @default(0)
  issueDate DateTime @default(now())
  dueDate   DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items InvoiceItem[]

  @@map("invoices")
  @@index([companyId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
  @@index([invoiceId])
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN
  entityType String  // PRODUCT, PO, INVOICE, etc
  entityId  String?
  changes   String?  // JSON stringified
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([companyId])
  @@index([createdAt])
}
