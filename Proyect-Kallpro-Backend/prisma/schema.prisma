model CrmAgent {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String // router | sdr | researcher | copywriter | closer | success
  name            String // Sofía · SDR
  model           String // claude-sonnet-4-20250514 | claude-haiku-4-5-20251001
  systemPrompt    String   @db.Text
  maxTokens       Int      @default(1500)
  temperature     Float    @default(0.5)
  tools           Json     @default("[]") // tool definitions
  autonomyDefault String   @default("setter_closer")
  isActive        Boolean  @default(true)
  metrics         Json?    @default("{}") // métricas acumuladas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs CrmAgentRun[]

  @@unique([companyId, code])
  @@index([companyId])
