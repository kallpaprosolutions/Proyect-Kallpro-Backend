model CrmMessage {
  id               String          @id @default(uuid())
  conversationId   String
  conversation     CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId       String? // ID del mensaje en Unipile
  direction        String // inbound | outbound
  channel          String // whatsapp | telegram | gmail
  body             String
  attachments      Json?           @default("[]")
  status           String          @default("sent") // sent | delivered | read | failed
  sentAt           DateTime        @default(now())
  senderType       String          @default("human") // human | ai_agent
  agentCode        String? // si senderType=ai_agent
  requiresApproval Boolean         @default(false)
  approvedBy       String?
  approvedAt       DateTime?

  @@index([conversationId])
  @@index([direction])
  @@index([sentAt])
