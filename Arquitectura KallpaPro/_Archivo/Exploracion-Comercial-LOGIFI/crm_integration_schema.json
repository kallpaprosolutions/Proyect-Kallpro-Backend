      "crm.ai.suggest",
      "crm.deals.view",
      "crm.deals.create",
      "crm.deals.edit",
      "crm.deals.delete",
      "crm.contacts.view",
      "crm.contacts.create",
      "crm.contacts.edit",
      "crm.companies.view",
      "crm.companies.edit",
      "crm.agents.view",
      "crm.agents.configure",
      "crm.workflows.view",
      "crm.workflows.create",
      "crm.workflows.edit",
      "crm.forecast.view",
      "crm.intelligence.view",
      "crm.admin"
    ],
    "default_roles": {
